# ================================================================
# AMU-ECSF Counseling Telegram Bot Configuration Template
# ================================================================

# 1. Telegram Bot Token from @BotFather
# Example: BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=your_bot_token_here

# 2. Authorized Counselors Telegram User IDs
# Add the numeric Telegram IDs of your counselors separated by commas.
# Example: COUNSELOR_IDS=123456789,987654321,555444333
COUNSELOR_IDS=

# 3. (Optional) Counselor Team Group Chat ID
# If you have a Telegram Group or Supergroup where your counselors hang out,
# you can add the bot to that group and put the group ID here.
# The bot will post new incoming seeker requests into the group feed!
# Group IDs typically start with a minus, e.g. -1001234567890
COUNSELOR_GROUP_ID=

# 4. Optional Customizations
BOT_NAME=AMU-ECSF Counseling Bot
DATABASE_PATH=counseling_bot.db
